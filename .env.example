# Required: bot token from the Discord Developer Portal.
DISCORD_TOKEN=CU3yK-TxAIdqBvF8lXUlQcQl6YtY8_s-

# Optional: numeric development guild ID for fast slash-command sync.
# Leave empty to sync commands globally.
GUILD_ID=

# Optional paths/settings.
EVENTS_CONFIG_PATH=config/events.json
DEFAULT_TIMEZONE=UTC
TTS_VOICE=en-US-AriaNeural
TTS_CACHE_DIR=cache/tts
FFMPEG_EXECUTABLE=ffmpeg
# Restart-safe per-guild voice channel settings.
VOICE_CONFIG_PATH=config/voice_channels.json
# Linear PCM volume from 0.0 (mute) to 2.0 (200%); /volume changes a guild at runtime.
VOICE_VOLUME=1.0
LOG_LEVEL=INFO
